# Environment Configuration for CollegeFinder

# PostgreSQL Database Connection String
# For local PostgreSQL: postgresql://username:password@localhost:5432/collegefinder?schema=public
# For Neon / Supabase: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collegefinder?schema=public"

# Authentication Secret (min 32 characters for HMAC SHA-256 JWT)
JWT_SECRET="collegefinder_production_secure_jwt_secret_key_32chars_min"

# Canonical Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
